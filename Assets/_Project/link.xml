<!-- Code the WebGL build's managed code stripping must keep (BuildMenu.ConfigureWebGL strips at Medium): the game's own
     assembly and Netcode, which are reached through generated code and reflection. -->
<linker>
  <assembly fullname="RPG.Runtime" preserve="all"/>
  <assembly fullname="Unity.Netcode.Runtime" preserve="all"/>
  <assembly fullname="Unity.Networking.Transport" preserve="all"/>
  <assembly fullname="Unity.InputSystem" preserve="all"/>
</linker>
