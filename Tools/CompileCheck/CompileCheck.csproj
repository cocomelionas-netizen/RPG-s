<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles src/ (copied by sync.sh) with the stubs against Unity's reference DLLs from setup.sh. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0067;CS0414;CS0649;CS0169;CS0108;CS0618;CS8632</NoWarn>
    <DefineConstants>UNITY_EDITOR</DefineConstants>
    <RefsDir Condition="'$(RPG_REFS)' == ''">/tmp/rpgrefs</RefsDir>
    <RefsDir Condition="'$(RPG_REFS)' != ''">$(RPG_REFS)</RefsDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="TestStubs.cs" />
    <Reference Include="$(RefsDir)/unityref/lib/net35/*.dll" />
    <Reference Include="$(RefsDir)/uiref/lib/UnityEngine.UI.dll" />
    <PackageReference Include="NUnit" Version="3.13.3" />
  </ItemGroup>
</Project>
